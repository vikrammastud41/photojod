  });

  /* ---------- Canvas render (N photos) ---------- */
  function sum(arr) { return arr.reduce(function (a, b) { return a + b; }, 0); }
  function maxOf(arr) { return arr.reduce(function (a, b) { return Math.max(a, b); }, 0); }

  function render() {
    var items = [];
    SLOTS.forEach(function (s, i) {
      if (!s.img) return;
      var sx = s.crop ? s.crop.x : 0, sy = s.crop ? s.crop.y : 0;
      var sw = s.crop ? s.crop.w : natW(s.img);
      var sh = s.crop ? s.crop.h : natH(s.img);
      items.push({ im: s.img, sx: sx, sy: sy, sw: sw, sh: sh, label: 'Photo ' + (i + 1), w: sw, h: sh, ow: sw, oh: sh });
    });

    if (items.length === 0) {
      canvas.hidden = true;
      noImg.hidden = false;
      outInfo.textContent = '';
      downloadBtn.disabled = true;
      return;
    }

    var n = items.length;
    var mode = layoutMode();           // h | v | g
    var eq = equalEl.checked;
    var g = gap(), p = pad();

    // Equal size: sabse badi dimension ko 1:1 rakhte hue baaki ko match karo
    if (eq && mode !== 'v') {          // row/grid → sab same height
      var H0 = maxOf(items.map(function (it) { return it.h; }));
      items.forEach(function (it) { it.w = Math.round(it.w * H0 / it.h); it.h = H0; });
    }
    if (eq && mode === 'v') {          // column → sab same width
      var W0 = maxOf(items.map(function (it) { return it.w; }));
      items.forEach(function (it) { it.h = Math.round(it.h * W0 / it.w); it.w = W0; });
    }

    // Grid arrangement
    var cols = 0, rows = 0, colW = [], rowH = [];
    if (mode === 'g') {
      cols = (n === 1) ? 1 : (n <= 4 ? 2 : 3);
      rows = Math.ceil(n / cols);
      for (var r = 0; r < rows; r++) rowH.push(0);
      for (var c = 0; c < cols; c++) colW.push(0);
      items.forEach(function (it, i) {
        var rr = Math.floor(i / cols), cc = i % cols;
        it.row = rr; it.col = cc;
        rowH[rr] = Math.max(rowH[rr], it.h);
        colW[cc] = Math.max(colW[cc], it.w);
      });
    }

    // Total size
    var W, H;
    if (mode === 'h') {
      W = sum(items.map(function (it) { return it.w; })) + g * (n - 1);
      H = maxOf(items.map(function (it) { return it.h; }));
    } else if (mode === 'v') {
      H = sum(items.map(function (it) { return it.h; })) + g * (n - 1);
      W = maxOf(items.map(function (it) { return it.w; }));
    } else {
      W = sum(colW) + g * (cols - 1);
      H = sum(rowH) + g * (rows - 1);
    }
    W += 2 * p; H += 2 * p;

    // Bahut bade output se bachne ke liye scale-down (high-quality limit)
    var MAX_SIDE = 16384, MAX_AREA = 80e6;
    var f = Math.min(1, MAX_SIDE / W, MAX_SIDE / H, Math.sqrt(MAX_AREA / (W * H)));
    if (f < 1) {
      items.forEach(function (it) {
        it.w = Math.max(1, Math.round(it.w * f));
        it.h = Math.max(1, Math.round(it.h * f));
      });
      g = Math.round(g * f); p = Math.round(p * f);
      colW = colW.map(function (x) { return Math.max(1, Math.round(x * f)); });
      rowH = rowH.map(function (x) { return Math.max(1, Math.round(x * f)); });
      if (mode === 'h') {
        W = sum(items.map(function (it) { return it.w; })) + g * (n - 1) + 2 * p;
        H = maxOf(items.map(function (it) { return it.h; })) + 2 * p;
      } else if (mode === 'v') {
        H = sum(items.map(function (it) { return it.h; })) + g * (n - 1) + 2 * p;
        W = maxOf(items.map(function (it) { return it.w; })) + 2 * p;
      } else {
        W = sum(colW) + g * (cols - 1) + 2 * p;
        H = sum(rowH) + g * (rows - 1) + 2 * p;
      }
    }
    W = Math.max(1, Math.round(W)); H = Math.max(1, Math.round(H));

    // Positions
    if (mode === 'h') {
      var x = p;
      items.forEach(function (it) {
        it.x = x; it.y = p + (H - 2 * p - it.h) / 2;
        x += it.w + g;
      });
    } else if (mode === 'v') {
      var y = p;
      items.forEach(function (it) {
        it.y = y; it.x = p + (W - 2 * p - it.w) / 2;
        y += it.h + g;
      });
    } else {
      var colX = [p], rowY = [p];
      for (var c2 = 1; c2 < cols; c2++) colX.push(colX[c2 - 1] + colW[c2 - 1] + g);
      for (var r2 = 1; r2 < rows; r2++) rowY.push(rowY[r2 - 1] + rowH[r2 - 1] + g);
      items.forEach(function (it) {
        it.x = colX[it.col] + (colW[it.col] - it.w) / 2;
        it.y = rowY[it.row] + (rowH[it.row] - it.h) / 2;
      });
    }

    // Draw
    canvas.width = W; canvas.height = H;
    canvas.hidden = false;
    noImg.hidden = true;

    var wantTransparent = transparentEl.checked && fmt() === 'png';
    if (!wantTransparent) {
      ctx.fillStyle = bgEl.value;
      ctx.fillRect(0, 0, W, H);
    } else {
      ctx.clearRect(0, 0, W, H);
    }

    ctx.imageSmoothingQuality = 'high';
    items.forEach(function (it) {
      ctx.drawImage(it.im, it.sx, it.sy, it.sw, it.sh, Math.round(it.x), Math.round(it.y), it.w, it.h);
    });

    // Watermark (service/branding ke liye)
    var wmText = wmTextEl.value.trim();
    if (wmOnEl.checked && wmText) {
      var pos = document.querySelector('input[name="wmpos"]:checked').value;
      var wsize = (pos === 'center')
        ? Math.max(28, Math.round(Math.min(W, H) * 0.12))
        : Math.max(16, Math.round(H * 0.03));
      ctx.save();
      ctx.font = 'bold ' + wsize + 'px system-ui, sans-serif';
      var twm = ctx.measureText(wmText).width;
      if (twm > W - 2 * p) {
        wsize = Math.max(10, wsize * (W - 2 * p) / twm);
        ctx.font = 'bold ' + wsize + 'px system-ui, sans-serif';
        twm = ctx.measureText(wmText).width;
      }
      ctx.shadowColor = 'rgba(0,0,0,.45)';
      ctx.shadowBlur = wsize * 0.15;
      ctx.fillStyle = 'rgba(255,255,255,.72)';
      if (pos === 'center') {
        ctx.fillText(wmText, (W - twm) / 2, H / 2 + wsize * 0.35);
      } else if (pos === 'br') {
        ctx.fillText(wmText, W - p - twm - wsize * 0.5, H - p - wsize * 0.5);
      } else {
        ctx.fillText(wmText, p + wsize * 0.5, H - p - wsize * 0.5);
      }
      ctx.restore();
    }

    // Quality report
    var modeName = mode === 'h' ? 'Side by Side' : (mode === 'v' ? 'Upar–Neeche' : ('Grid ' + cols + '×' + rows));
    var lines = ['Output: ' + W + ' × ' + H + ' px • ' + n +
      (n > 1 ? ' photos' : ' photo') + ' • ' + modeName +
      (wantTransparent ? ' • transparent' : '')];

    function pixLine(it) {
      if (it.w === it.ow && it.h === it.oh) {
        return '✓ ' + it.label + ': 1:1 original pixels — ZERO quality loss';
      }
      var pct = Math.round(it.w / it.ow * 100);
      return (pct > 100 ? '⬆ ' : '⚠ ') + it.label + ': ' +
        it.ow + '×' + it.oh + ' → ' + it.w + '×' + it.h + ' (' + pct + '%)';
    }
    items.forEach(function (it) { lines.push(pixLine(it)); });
    if (f < 1) lines.push('⚠ Output bahut bada tha — ' + Math.round(f * 100) + '% scale kiya gaya (limit paas)');

    outInfo.textContent = lines.join('\n');
    downloadBtn.disabled = false;
  }

  /* ---------- Crop editor ---------- */
  var cropOv = $('cropOv'), cImg = $('cImg'),
      cBox = $('cBox'), cDims = $('cDims'), cctx = cImg.getContext('2d');

  var cw = { i: -1, img: null, k: 1, dw: 0, dh: 0,
             x: 0, y: 0, w: 0, h: 0, ratio: null,
             mode: null, sx0: 0, sy0: 0, bx0: 0, by0: 0, bw0: 0, bh0: 0 };

  function initCropView() {
    var nw0 = natW(cw.img), nh0 = natH(cw.img);
    var maxW = Math.min(820, window.innerWidth - 70);
    var maxH = Math.max(220, Math.round(window.innerHeight * 0.52));
    cw.k = Math.min(maxW / nw0, maxH / nh0, 1.5);
    cw.dw = Math.max(1, Math.round(nw0 * cw.k));
    cw.dh = Math.max(1, Math.round(nh0 * cw.k));
    cImg.width = cw.dw; cImg.height = cw.dh;
    cImg.style.width = cw.dw + 'px';
    cImg.style.height = cw.dh + 'px';
    cctx.imageSmoothingQuality = 'high';
    cctx.drawImage(cw.img, 0, 0, cw.dw, cw.dh);
    cw.w = cw.dw * 0.8; cw.h = cw.dh * 0.8;
    cw.x = (cw.dw - cw.w) / 2;
    cw.y = (cw.dh - cw.h) / 2;
    drawBox();
  }

  function cropOpen(i) {
    var s = SLOTS[i];
    if (!s || !s.img) return;
    cw.i = i; cw.img = s.img; cw.ratio = null;
    setRActive('');
    // Purana crop ho to wahi box shuru me dikha do
    var hadCrop = s.crop;
    initCropView();
    if (hadCrop) {
      cw.x = hadCrop.x * cw.k; cw.y = hadCrop.y * cw.k;
      cw.w = hadCrop.w * cw.k; cw.h = hadCrop.h * cw.k;
      drawBox();
    }
    cropOv.hidden = false;
  }

  function drawBox() {
    cBox.style.left = cw.x + 'px';
    cBox.style.top = cw.y + 'px';
    cBox.style.width = cw.w + 'px';
    cBox.style.height = cw.h + 'px';
    cDims.textContent = Math.max(1, Math.round(cw.w / cw.k)) + ' × ' +
                        Math.max(1, Math.round(cw.h / cw.k)) + ' px';
  }

  function parseR(v) { var p = v.split('/'); return (+p[0]) / (+p[1]); }

  function setRActive(val) {
    Array.prototype.forEach.call(document.querySelectorAll('.rbtn'), function (b) {
      b.classList.toggle('active', b.getAttribute('data-r') === val);
    });
  }

  function setRatio(val) {
    cw.ratio = val ? parseR(val) : null;
    setRActive(val);
    if (cw.ratio) {
      var r = cw.ratio;
      var cxm = cw.x + cw.w / 2, cym = cw.y + cw.h / 2;
      var w = Math.min(cw.dw, cw.dh * r);
      var h = w / r;
      cw.w = w; cw.h = h;
      cw.x = clamp(cxm - w / 2, 0, cw.dw - w);
      cw.y = clamp(cym - h / 2, 0, cw.dh - h);
      drawBox();
    }
  }

  Array.prototype.forEach.call(document.querySelectorAll('.rbtn'), function (b) {
    b.addEventListener('click', function () { setRatio(b.getAttribute('data-r')); });
  });

  function bakeRotate(deg) {
    var im = cw.img, w = natW(im), h = natH(im);
    var c = document.createElement('canvas');
    c.width = h; c.height = w;
    var cc = c.getContext('2d');
    cc.translate(c.width / 2, c.height / 2);
    cc.rotate(deg * Math.PI / 180);
    cc.drawImage(im, -w / 2, -h / 2);
    cw.img = c;
    cw.ratio = null;
    setRActive('');
    initCropView();
  }
  $('rotL').addEventListener('click', function () { bakeRotate(-90); });
  $('rotR').addEventListener('click', function () { bakeRotate(90); });

  $('cropReset').addEventListener('click', function () {
    cw.ratio = null; setRActive('');
    cw.w = cw.dw; cw.h = cw.dh; cw.x = 0; cw.y = 0;
    drawBox();
  });
  $('cropCancel').addEventListener('click', function () { cropOv.hidden = true; });
  $('cropApply').addEventListener('click', function () {
    var s = SLOTS[cw.i];
    if (!s) return;
    s.img = cw.img;
    var NW = natW(s.img), NH = natH(s.img);
    var nx = clamp(Math.round(cw.x / cw.k), 0, NW - 1);
    var ny = clamp(Math.round(cw.y / cw.k), 0, NH - 1);
    var nw2 = clamp(Math.round(cw.w / cw.k), 1, NW - nx);
    var nh2 = clamp(Math.round(cw.h / cw.k), 1, NH - ny);
    s.crop = (nw2 === NW && nh2 === NH && nx === 0 && ny === 0) ? null : { x: nx, y: ny, w: nw2, h: nh2 };
    cropOv.hidden = true;
    updateSlotUI(cw.i);
    render();
  });

  /* --- drag & resize (mouse + touch, pointer events) --- */
  function pd(e, mode) {
    e.preventDefault(); e.stopPropagation();
    cw.mode = mode;
    cw.sx0 = e.clientX; cw.sy0 = e.clientY;
    cw.bx0 = cw.x; cw.by0 = cw.y; cw.bw0 = cw.w; cw.bh0 = cw.h;
  }
  function pm(e) {
    if (!cw.mode) return;
    var dx = e.clientX - cw.sx0, dy = e.clientY - cw.sy0;
    applyDrag(dx, dy);
  }
  function pu() { cw.mode = null; }

  function applyDrag(dx, dy) {
    var r = cw.ratio, m = cw.mode, MIN = 24;
    var dw = cw.dw, dh = cw.dh;
    var bx = cw.bx0, by = cw.by0, bw = cw.bw0, bh = cw.bh0;

    if (m === 'move') {
      cw.x = clamp(bx + dx, 0, dw - bw);
      cw.y = clamp(by + dy, 0, dh - bh);
    } else if (m === 'se') {
      var w = clamp(bw + dx, MIN, dw - bx);
      var h = clamp(bh + dy, MIN, dh - by);
      if (r) { h = w / r; if (by + h > dh) { h = dh - by; w = h * r; } if (w > dw - bx) { w = dw - bx; h = w / r; } }
      cw.w = w; cw.h = h;
    } else if (m === 'sw') {
      var x2 = bx + bw, y2b = by + bh;
      var nx = clamp(bx + dx, 0, x2 - MIN);
      var w2 = x2 - nx;
      var h2 = clamp(bh + dy, MIN, dh - by);
      if (r) { w2 = h2 * r; if (w2 > x2) { w2 = x2; h2 = w2 / r; } }
      cw.x = x2 - w2; cw.w = w2; cw.h = h2;
    } else if (m === 'ne') {
      var y2c = by + bh;
      var w3 = clamp(bw + dx, MIN, dw - bx);
      var h3 = clamp(y2c - (by + dy), MIN, y2c);
      if (r) { h3 = w3 / r; if (h3 > y2c) { h3 = y2c; w3 = h3 * r; } if (w3 > dw - bx) { w3 = dw - bx; h3 = w3 / r; } }
      cw.w = w3; cw.y = y2c - h3; cw.h = h3;
    } else if (m === 'nw') {
      var x2d = bx + bw, y2d = by + bh;
      var nx2 = clamp(bx + dx, 0, x2d - MIN);
      var ny2 = clamp(by + dy, 0, y2d - MIN);
      var w4 = x2d - nx2, h4 = y2d - ny2;
      if (r) { h4 = w4 / r; if (h4 > y2d) { h4 = y2d; w4 = h4 * r; } if (w4 > x2d) { w4 = x2d; h4 = w4 / r; } }
      cw.x = x2d - w4; cw.y = y2d - h4; cw.w = w4; cw.h = h4;
    } else if (m === 'n') {
      var y2e = by + bh;
      var ny3 = clamp(by + dy, 0, y2e - MIN);
      var h5 = y2e - ny3;
      if (r) {
        var w5 = Math.min(h5 * r, dw);
        cw.w = w5; cw.x = clamp(bx + bw / 2 - w5 / 2, 0, dw - w5);
        h5 = w5 / r;
      }
      cw.y = y2e - h5; cw.h = h5;
    } else if (m === 's') {
      var h6 = clamp(bh + dy, MIN, dh - by);
      if (r) {
        var w6 = Math.min(h6 * r, dw);
        cw.w = w6; cw.x = clamp(bx + bw / 2 - w6 / 2, 0, dw - w6);
        h6 = w6 / r;
      }
      cw.h = h6;
    } else if (m === 'w') {
      var x2f = bx + bw;
      var nx3 = clamp(bx + dx, 0, x2f - MIN);
      var w7 = x2f - nx3;
      if (r) {
        var h7 = Math.min(w7 / r, dh);
        cw.h = h7; cw.y = clamp(by + bh / 2 - h7 / 2, 0, dh - h7);
        w7 = h7 * r;
      }
      cw.x = x2f - w7; cw.w = w7;
    } else if (m === 'e') {
      var w8 = clamp(bw + dx, MIN, dw - bx);
      if (r) {
        var h8 = Math.min(w8 / r, dh);
        cw.h = h8; cw.y = clamp(by + bh / 2 - h8 / 2, 0, dh - h8);
        w8 = h8 * r;
      }
      cw.w = w8;
    }
    drawBox();
  }

  cBox.addEventListener('pointerdown', function (e) {
    if (e.target === cBox) pd(e, 'move');
  });
  Array.prototype.forEach.call(document.querySelectorAll('.hd'), function (h) {
    h.addEventListener('pointerdown', function (e) { pd(e, h.getAttribute('data-h')); });
  });
  window.addEventListener('pointermove', pm);
  window.addEventListener('pointerup', pu);
  window.addEventListener('pointercancel', pu);

  /* ---------- Download ---------- */
  var dlHelp = $('dlHelp'), dlImg = $('dlImg');
  var lastURL = null;

  // Kya ye file kisi iframe/preview ke andar chal rahi hai?
  var isEmbedded = (function () {
    try { return window.self !== window.top; } catch (e) { return true; }
  })();

  function doDownload() {
    if (downloadBtn.disabled) return;
    var format = fmt();
    var mime = format === 'jpg' ? 'image/jpeg' : 'image/png';
    var quality = format === 'jpg' ? Math.min(1, +qEl.value / 100) : undefined;
    canvas.toBlob(function (blob) {
      if (!blob) { alert('Image banane me problem aayi. Dobara try karo.'); return; }
      if (lastURL) URL.revokeObjectURL(lastURL);
      lastURL = URL.createObjectURL(blob);

      var a = document.createElement('a');
      a.href = lastURL;
      a.download = 'side-by-side.' + format;
      document.body.appendChild(a);
      a.click();
      a.remove();

      // Preview/iframe ke andar download aksar block hota hai — help popup dikha do
      if (isEmbedded) {
        dlImg.src = lastURL;
        dlHelp.hidden = false;
      }
    }, mime, quality);
  }

  downloadBtn.addEventListener('click', doDownload);

  $('dlRetry').addEventListener('click', doDownload);
  $('dlClose').addEventListener('click', function () { dlHelp.hidden = true; });
  $('dlTab').addEventListener('click', function () {
    if (!lastURL) return;
    var w = null;
    try { w = window.open(lastURL, '_blank'); } catch (e) { w = null; }
    if (!w) {
      alert('Browser ne naya tab block kar diya (preview security).\n\nPakka solution: side-by-side-photo.html file ko device par save karke seedha browser me kholo — wahan sab kaam karega.');
    }
  });

  render();
})();
</script>
