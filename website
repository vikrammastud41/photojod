  /* ---------- Business banner (apna ad) ---------- */
  var promoOnEl = $('promoOn'), promoRowEl = $('promoRow'),
      promoTextEl = $('promoText'), promoPhoneEl = $('promoPhone'),
      promoEl = $('promo'), promoTxtEl = $('promoTxt'),
