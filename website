<script>
(function () {
  'use strict';

  var MAX_SLOTS = 8;
  var SLOTS = [];

  var $ = function (id) { return document.getElementById(id); };
  var canvas = $('out'), ctx = canvas.getContext('2d');
  var noImg = $('noImg'), outInfo = $('outInfo'), downloadBtn = $('downloadBtn');
  var slotsEl = $('slots'), addBtn = $('addBtn');

  /* ---------- Build upload slots (dynamic) ---------- */
  function slotName(i) { return 'Photo ' + (i + 1); }

  function addSlot() {
    if (SLOTS.length >= MAX_SLOTS) {
      alert('Max ' + MAX_SLOTS + ' photos tak support hai.');
      return false;
    }
    var i = SLOTS.length;
    var s = { name: slotName(i), img: null, url: null, fname: '', crop: null };

    var d = document.createElement('div');
    d.className = 'slot';
    d.innerHTML =
      '<input type="file" accept="image/*" class="file" hidden>' +
      '<div class="empty">' +
        '<div class="ic">🖼️</div>' +
        '<div class="nm">' + s.name + '</div>' +
        '<div class="hint">Click karo ya yahan<br>drag &amp; drop karo</div>' +
      '</div>' +
      '<div class="filled" hidden>' +
        '<img class="thumb" alt="">' +
        '<div class="fname"></div>' +
        '<div class="fname fd"></div>' +
        '<div class="acts">' +
          '<button type="button" class="btn cp" title="Crop karo">✂️</button>' +
          '<button type="button" class="btn ch" title="Badlo">🔄</button>' +
          '<button type="button" class="btn rm" title="Hatao">🗑️</button>' +
        '</div>' +
      '</div>';
    slotsEl.appendChild(d);

    var input  = d.querySelector('.file');
    var empty  = d.querySelector('.empty');
    var filled = d.querySelector('.filled');
    var thumb  = d.querySelector('.thumb');
    var fname  = d.querySelector('.fname');
    var fd     = d.querySelector('.fd');

    d.addEventListener('click', function (e) {
      if (!e.target.closest('button')) input.click();
    });
    d.querySelector('.cp').addEventListener('click', function (e) { e.stopPropagation(); cropOpen(i); });
    d.querySelector('.ch').addEventListener('click', function (e) { e.stopPropagation(); input.click(); });
    d.querySelector('.rm').addEventListener('click', function (e) { e.stopPropagation(); clearSlot(i); });

    input.addEventListener('change', function () {
      if (input.files[0]) loadFile(i, input.files[0]);
      input.value = '';
    });

    d.addEventListener('dragover', function (e) { e.preventDefault(); d.classList.add('drag'); });
    d.addEventListener('dragleave', function () { d.classList.remove('drag'); });
    d.addEventListener('drop', function (e) {
      e.preventDefault(); d.classList.remove('drag');
      var f = e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) loadFile(i, f);
    });

    s.ui = { slot: d, empty: empty, filled: filled, thumb: thumb, fname: fname };
    SLOTS.push(s);
    return true;
  }

  function natW(im) { return im.naturalWidth || im.width; }
  function natH(im) { return im.naturalHeight || im.height; }
  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

  function updateSlotUI(i) {
    var s = SLOTS[i], ui = s.ui;
    if (s.img) {
      ui.empty.hidden = true;
      ui.filled.hidden = false;
      renderThumb(i);
    } else {
      ui.filled.hidden = true;
      ui.empty.hidden = false;
    }
  }

  // Slot ka thumbnail = cropped region ka chhota preview
  function renderThumb(i) {
    var s = SLOTS[i];
    if (!s.img) return;
    var sx = s.crop ? s.crop.x : 0, sy = s.crop ? s.crop.y : 0;
    var sw = s.crop ? s.crop.w : natW(s.img);
    var sh = s.crop ? s.crop.h : natH(s.img);
    var sc = Math.min(1, 300 / Math.max(sw, sh));
    var t = document.createElement('canvas');
    t.width = Math.max(1, Math.round(sw * sc));
    t.height = Math.max(1, Math.round(sh * sc));
    t.getContext('2d').drawImage(s.img, sx, sy, sw, sh, 0, 0, t.width, t.height);
    s.ui.thumb.src = t.toDataURL('image/png');
    s.ui.fname.textContent = s.fname;
    s.ui.fd.textContent = sw + '×' + sh + (s.crop ? ' ✂' : '');
  }

  function loadFile(i, file) {
    if (!file.type || file.type.indexOf('image/') !== 0) {
      alert('Sirf photo/image file chalegi! (JPG, PNG, WebP, GIF...)');
      return;
    }
    var url = URL.createObjectURL(file);
    var img = new Image();
    img.onload = function () {
      if (SLOTS[i].url) URL.revokeObjectURL(SLOTS[i].url);
      SLOTS[i].img = img;
      SLOTS[i].url = url;
      SLOTS[i].fname = file.name;
      SLOTS[i].crop = null;
      updateSlotUI(i);
      // Agar last slot fill hua to naya khali slot auto-add (max tak)
      if (i === SLOTS.length - 1 && SLOTS.length < MAX_SLOTS) addSlot();
      render();
    };
    img.onerror = function () {
      URL.revokeObjectURL(url);
      alert('Ye image load nahi ho payi. Dobara try karo.');
    };
    img.src = url;
  }

